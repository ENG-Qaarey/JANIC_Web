{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "janic",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://janic.muscabaxmed762.workers.dev"
  }
}
