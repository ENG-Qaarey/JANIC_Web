datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  EDITOR
  STAFF
  USER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum PartnershipStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  APPROVED
  REJECTED
  CLOSED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model Project {
  id           String               @id @default(cuid())
  title        String
  slug         String               @unique
  summary      String               @db.Text
  problem      String               @db.Text
  solution     String               @db.Text
  technology   String               @db.Text
  innovation   String?              @db.Text
  outcomes     String?              @db.Text
  category     String
  status       ContentStatus        @default(DRAFT)
  isFeatured   Boolean              @default(false)
  heroImage    String?
  demoUrl      String?
  videoUrl     String?
  githubUrl    String?
  teamMembers  String?              @db.Text
  order        Int                  @default(0)
  publishedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  gallery      ProjectGalleryItem[]
  members      ProjectMember[]

  @@index([status, isFeatured])
  @@index([category])
  @@index([slug])
}

model ProjectGalleryItem {
  id        String   @id @default(cuid())
  projectId String
  imageUrl  String
  caption   String?
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model TrainingProgram {
  id            String            @id @default(cuid())
  title         String
  slug          String            @unique
  summary       String            @db.Text
  description   String            @db.Text
  category      String
  level         String            @default("Intermediate")
  duration      String
  schedule      String
  startDate     DateTime?
  endDate       DateTime?
  mode          String            @default("On-Campus")
  certification String?
  status        ContentStatus     @default(DRAFT)
  isFeatured    Boolean           @default(false)
  coverImage    String?           @db.Text
  maxSeats      Int?
  syllabus      String?           @db.Text
  trainers      String?           @db.Text
  allowComments Boolean           @default(true)
  allowInteractions Boolean       @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  comments      TrainingComment[]
  likes         TrainingLike[]
  ratings       TrainingRating[]

  @@index([status, isFeatured])
  @@index([category])
  @@index([slug])
}

model TrainingComment {
  id         String          @id @default(cuid())
  trainingId String
  userId     String
  userName   String
  userAvatar String?         @db.Text
  message    String          @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  training   TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
  @@index([userId])
}

model TrainingLike {
  id         String          @id @default(cuid())
  trainingId String
  userId     String
  createdAt  DateTime        @default(now())
  training   TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([trainingId])
}

model TrainingRating {
  id         String          @id @default(cuid())
  trainingId String
  userId     String
  stars      Int             @default(5)
  feedback   String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  training   TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([trainingId])
}

model ResearchPaper {
  id                  String            @id @default(cuid())
  title               String
  slug                String            @unique
  abstract            String            @db.Text
  content             String?           @db.Text
  authors             String            @db.Text
  authorsData         String?           @db.Text
  category            String
  publicationDate     DateTime?
  journalOrConference String?
  doi                 String?
  pdfUrl              String?           @db.Text
  status              ContentStatus     @default(DRAFT)
  isFeatured          Boolean           @default(false)
  allowComments       Boolean           @default(true)
  allowInteractions   Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  comments            ResearchComment[]
  likes               ResearchLike[]
  ratings             ResearchRating[]

  @@index([status, isFeatured])
  @@index([category])
  @@index([slug])
}

model ResearchComment {
  id         String        @id @default(cuid())
  paperId    String
  userId     String
  userName   String
  userAvatar String?       @db.Text
  message    String        @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  paper      ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([userId])
}

model ResearchLike {
  id        String        @id @default(cuid())
  paperId   String
  userId    String
  createdAt DateTime      @default(now())
  paper     ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@index([paperId])
}

model ResearchRating {
  id        String        @id @default(cuid())
  paperId   String
  userId    String
  stars     Int           @default(5)
  feedback  String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  paper     ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@index([paperId])
}

model Event {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String        @db.Text
  description     String        @db.Text
  category        String
  eventDate       DateTime
  endDate         DateTime?
  location        String
  isVirtual       Boolean       @default(false)
  registrationUrl String?       @db.Text
  capacity        Int?
  status          ContentStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  coverImage      String?       @db.Text
  videoUrl        String?       @db.Text
  attendeesCount  Int?
  gallery         String?       @db.Text
  guests          String?       @db.Text
  agenda          String?       @db.Text
  keyHighlights   String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, eventDate])
  @@index([category])
  @@index([slug])
}

model InnovationSubmission {
  id                   String           @id @default(cuid())
  title                String
  category             String
  problemStatement     String           @db.Text
  solutionDescription  String           @db.Text
  technologyStack      String?          @db.Text
  submitterName        String
  submitterEmail       String
  submitterPhone       String
  facultyOrDepartment  String?
  studentId            String?
  teamMembers          String?          @db.Text
  prototypeUrl         String?
  videoUrl             String?
  attachmentUrl        String?
  status               SubmissionStatus @default(PENDING)
  reviewNotes          String?          @db.Text
  convertedToProjectId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status, createdAt])
}

model PartnershipInquiry {
  id                String   @id @default(cuid())
  organizationName  String
  organizationType  String
  contactName       String
  email             String
  phone             String?
  collaborationArea String
  proposalDetails   String   @db.Text
  status            String   @default("NEW")
  isApproved        Boolean  @default(false)
  isRejected        Boolean  @default(false)
  adminNotes        String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
}

model ContactMessage {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String        @db.Text
  status     MessageStatus @default(UNREAD)
  adminNotes String?       @db.Text
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model TeamMember {
  id         String   @id @default(cuid())
  name       String
  role       String
  department String   @default("Faculty of Computer Science & IT")
  bio        String?  @db.Text
  avatar     String?
  email      String?
  linkedin   String?
  isFounder  Boolean  @default(false)
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, order])
}

model ProjectMember {
  id          String   @id @default(cuid())
  name        String
  role        String   @default("Team Member")
  department  String   @default("Faculty of Computer Science & IT")
  bio         String?  @db.Text
  avatar      String?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  github      String?
  linkedin    String?
  twitter     String?
  instagram   String?
  facebook    String?
  website     String?
  email       String?
  phone       String?
  tags        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([isActive, order])
}

model Media {
  id        String   @id @default(cuid())
  fileName  String
  url       String
  alt       String?
  width     Int?
  height    Int?
  mimeType  String?
  sizeBytes Int?
  folder    String   @default("general")
  caption   String?  @db.Text
  source    String   @default("post")
  createdAt DateTime @default(now())
  likes     MediaLike[]
  comments  MediaComment[]
}

model MediaLike {
  id        String   @id @default(cuid())
  mediaId   String
  visitorId String
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, visitorId])
  @@index([mediaId])
}

model MediaComment {
  id        String   @id @default(cuid())
  mediaId   String
  name      String
  message   String   @db.Text
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([key])
}

