generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  visitorId String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([commentId, visitorId, emoji], map: "uq_comment_visitor_emoji")
  @@index([commentId], map: "idx_commentId")
}

model ContactMessage {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String
  message    String
  status     MessageStatus @default(UNREAD)
  adminNotes String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model Event {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  summary         String
  description     String
  category        String
  eventDate       DateTime
  endDate         DateTime?
  location        String
  isVirtual       Boolean       @default(false)
  registrationUrl String?
  capacity        Int?
  status          ContentStatus @default(DRAFT)
  isFeatured      Boolean       @default(false)
  coverImage      String?
  videoUrl        String?
  attendeesCount  Int?
  gallery         String?
  guests          String?
  agenda          String?
  keyHighlights   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([category])
  @@index([slug])
  @@index([status, eventDate])
}

model Hub {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  description String
  icon        String?
  status      String   @default("Active")
  link        String?
  tags        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
  @@index([slug])
}

model InnovationSubmission {
  id                   String           @id @default(cuid())
  title                String
  category             String
  description          String
  technologyStack      String?
  submitterName        String
  submitterEmail       String
  submitterPhone       String
  studentId            String?
  teamMembers          String?
  prototypeUrl         String?
  videoUrl             String?
  attachmentUrl        String?
  status               SubmissionStatus @default(PENDING)
  reviewNotes          String?
  convertedToProjectId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([status, createdAt])
}

model Media {
  id           String         @id @default(cuid())
  fileName     String
  url          String
  alt          String?
  width        Int?
  height       Int?
  mimeType     String?
  sizeBytes    Int?
  folder       String         @default("general")
  caption      String?
  source       String         @default("post")
  createdAt    DateTime       @default(now())
  mediaComments MediaComment[]
  mediaLikes    MediaLike[]
}

model MediaComment {
  id        String   @id @default(cuid())
  mediaId   String
  name      String
  message   String
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

model MediaLike {
  id        String   @id @default(cuid())
  mediaId   String
  visitorId String
  createdAt DateTime @default(now())
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, visitorId])
  @@index([mediaId])
}

model Opportunity {
  id          String   @id @default(cuid())
  title       String
  type        String
  deadline    String
  department  String
  description String
  eligibility String
  actionUrl   String
  actionLabel String   @default("Apply Now")
  status      String   @default("Active")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

model OrganizationType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartnershipInquiry {
  id                String   @id @default(cuid())
  organizationName  String
  organizationType  String
  contactName       String
  email             String
  phone             String?
  collaborationArea String
  proposalDetails   String
  status            String   @default("NEW")
  isApproved        Boolean  @default(false)
  isRejected        Boolean  @default(false)
  adminNotes        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt])
}

model Project {
  id                 String               @id @default(cuid())
  title              String
  slug               String               @unique
  summary            String
  problem            String
  solution           String
  technology         String
  innovation         String?
  outcomes           String?
  category           String
  status             ContentStatus        @default(DRAFT)
  isFeatured         Boolean              @default(false)
  heroImage          String?
  demoUrl            String?
  videoUrl           String?
  githubUrl          String?
  teamMembers        String?
  order              Int                  @default(0)
  publishedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  gallery            ProjectGalleryItem[]
  members            ProjectMember[]

  @@index([category])
  @@index([slug])
  @@index([status, isFeatured])
}

model ProjectGalleryItem {
  id        String   @id @default(cuid())
  projectId String
  imageUrl  String
  caption   String?
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMember {
  id         String   @id @default(cuid())
  name       String
  role       String   @default("Team Member")
  department String   @default("Faculty of Computer Science & IT")
  bio        String?
  avatar     String?
  projectId  String?
  github     String?
  linkedin   String?
  twitter    String?
  instagram  String?
  facebook   String?
  website    String?
  email      String?
  phone      String?
  tags       String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project? @relation(fields: [projectId], references: [id])

  @@index([isActive, order])
  @@index([projectId])
}

model ResearchComment {
  id            String        @id @default(cuid())
  paperId       String
  userId        String
  userName      String
  userAvatar    String?
  message       String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  researchPaper ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([userId])
}

model ResearchLike {
  id            String        @id @default(cuid())
  paperId       String
  userId        String
  createdAt     DateTime      @default(now())
  researchPaper ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@index([paperId])
}

model ResearchPaper {
  id                  String            @id @default(cuid())
  title               String
  slug                String            @unique
  abstract            String
  content             String?
  authors             String
  authorsData         String?
  category            String
  publicationDate     DateTime?
  journalOrConference String?
  doi                 String?
  pdfUrl              String?
  status              ContentStatus     @default(DRAFT)
  isFeatured          Boolean           @default(false)
  allowComments       Boolean           @default(true)
  allowInteractions   Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  comments            ResearchComment[]
  likes               ResearchLike[]
  ratings             ResearchRating[]

  @@index([category])
  @@index([slug])
  @@index([status, isFeatured])
}

model ResearchRating {
  id            String        @id @default(cuid())
  paperId       String
  userId        String
  stars         Int           @default(5)
  feedback      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  researchPaper ResearchPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([paperId, userId])
  @@index([paperId])
}

model ResourceDocument {
  id          String   @id @default(cuid())
  title       String
  category    String
  format      String   @default("PDF")
  size        String   @default("500 KB")
  description String
  fileUrl     String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

model Service {
  id              String           @id @default(cuid())
  categoryId      String
  name            String
  description     String?
  order           Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@index([categoryId, isActive, order])
}

model ServiceCategory {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  icon            String?
  order           Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  services        Service[]
  serviceRequests ServiceRequest[]

  @@index([isActive, order])
}

model ServiceRequest {
  id                         String                     @id @default(cuid())
  requestNumber              String                     @unique
  organizationName           String
  organizationType           OrgType
  organizationCategory       OrganizationCategory
  contactPerson              String
  email                      String
  phone                      String
  website                    String?
  country                    String
  city                       String
  address                    String?
  serviceCategoryId          String
  serviceId                  String
  requestTitle               String
  description                String
  expectedOutcomes           String?
  beneficiaries              String?
  startDate                  DateTime?
  preferredCompletionDate    DateTime?
  budget                     String?
  preferredContactMethod     String                     @default("EMAIL")
  businessSector             String?
  businessOutcome            String?
  isExistingBusiness         Boolean?
  commercialRequirements     String?
  organizationMission        String?
  socialProblem              String?
  targetBeneficiaries        String?
  socialImpact               String?
  fundingStatus              FundingStatus?
  isExistingCommunityProject Boolean?
  additionalNotes            String?
  status                     ServiceRequestStatus       @default(SUBMITTED)
  priority                   ServiceRequestPriority     @default(MEDIUM)
  rejectionReason            String?
  submittedById              String?
  assignedToId               String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  reviewedAt                 DateTime?
  completedAt                DateTime?
  serviceCategoryRef         ServiceCategory            @relation(fields: [serviceCategoryId], references: [id])
  serviceRef                 Service                    @relation(fields: [serviceId], references: [id])
  attachments                ServiceRequestAttachment[]
  history                    ServiceRequestHistory[]
  notes                      ServiceRequestNote[]

  @@index([assignedToId, status])
  @@index([organizationType, status])
  @@index([requestNumber])
  @@index([serviceCategoryId, status])
  @@index([status, createdAt])
}

model ServiceRequestAttachment {
  id             String         @id @default(cuid())
  requestId      String
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String
  uploadedById   String
  createdAt      DateTime       @default(now())
  serviceRequest ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model ServiceRequestHistory {
  id             String                @id @default(cuid())
  requestId      String
  action         String
  fromStatus     ServiceRequestStatus?
  toStatus       ServiceRequestStatus?
  actorId        String
  notes          String?
  createdAt      DateTime              @default(now())
  serviceRequest ServiceRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
}

model ServiceRequestNote {
  id             String         @id @default(cuid())
  requestId      String
  authorId       String
  content        String
  createdAt      DateTime       @default(now())
  serviceRequest ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([key])
}

model TeamMember {
  id         String   @id @default(cuid())
  name       String
  role       String
  department String   @default("Faculty of Computer Science & IT")
  bio        String?
  avatar     String?
  email      String?
  linkedin   String?
  isFounder  Boolean  @default(false)
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, order])
}

model TrainingComment {
  id              String          @id @default(cuid())
  trainingId      String
  userId          String
  userName        String
  userAvatar      String?
  message         String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  training        TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
  @@index([userId])
}

model TrainingLike {
  id         String          @id @default(cuid())
  trainingId String
  userId     String
  createdAt  DateTime        @default(now())
  training   TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([trainingId])
}

model TrainingProgram {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  summary           String
  description       String
  category          String
  level             String            @default("Intermediate")
  duration          String
  schedule          String
  startDate         DateTime?
  endDate           DateTime?
  mode              String            @default("On-Campus")
  certification     String?
  status            ContentStatus     @default(DRAFT)
  isFeatured        Boolean           @default(false)
  coverImage        String?
  maxSeats          Int?
  syllabus          String?
  trainers          String?
  allowComments     Boolean           @default(true)
  allowInteractions Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  comments          TrainingComment[]
  likes             TrainingLike[]
  ratings           TrainingRating[]

  @@index([category])
  @@index([slug])
  @@index([status, isFeatured])
}

model TrainingRating {
  id         String          @id @default(cuid())
  trainingId String
  userId     String
  stars      Int             @default(5)
  feedback   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  training   TrainingProgram @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([trainingId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FundingStatus {
  FUNDED
  PARTIALLY_FUNDED
  SEEKING_FUNDING
  NOT_YET_DETERMINED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

enum OrgType {
  FOR_PROFIT
  NONPROFIT
}

enum OrganizationCategory {
  PRIVATE_COMPANY
  STARTUP_SMALL_BUSINESS
  NGO
  COMMUNITY_BASED_ORGANIZATION
  EDUCATIONAL_INSTITUTION
  FOUNDATION_CHARITY
  YOUTH_ORGANIZATION
  OTHER
}

enum PartnershipStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  APPROVED
  REJECTED
  CLOSED
}

enum Role {
  ADMIN
  EDITOR
  STAFF
  USER
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}
