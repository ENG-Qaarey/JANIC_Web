# -----------------------------------------------------------------------------
# DATABASE (Prisma / MySQL)
# -----------------------------------------------------------------------------
# Connection string format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:password@localhost:3306/janic_db"

# -----------------------------------------------------------------------------
# APPLICATION & SESSION AUTH
# -----------------------------------------------------------------------------
# Secret key used for signing JWT tokens and session verification
AUTH_SECRET="your_super_secret_session_jwt_key_here"

# Base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical public site URL (used for sitemaps, robots.txt, metadata)
NEXT_PUBLIC_SITE_URL="https://janic.edu.so"

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
# Local storage path for uploaded assets
UPLOAD_DIR="./public/uploads"

# Public URL prefix for uploaded media files
NEXT_PUBLIC_UPLOAD_PREFIX="/uploads"

# -----------------------------------------------------------------------------
# CLERK AUTHENTICATION (OAuth, Google & GitHub)
# -----------------------------------------------------------------------------
# Clerk Publishable Key (from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"

# Clerk Secret Key
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"

# Clerk Routing & Redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Email notifications (SMTP)
# Gmail requires an App Password, not your account password.
# The app password is shown in groups of 4 — spaces are stripped automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Where notification emails are delivered.
CONTACT_NOTIFICATION_EMAIL=
